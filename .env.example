# Copy to .env locally. In hosting, use server-side environment/secret settings.
SUPABASE_URL=
# Use the legacy service_role key from Supabase. NEVER a public/publishable key.
# A new sb_secret_ key also works; it backs the waitlist, signup, contact and quote-request tables.
SUPABASE_SERVICE_ROLE_KEY=
# In production set to the exact HTTPS origin, with no trailing slash or path.
# Remote MCP clients also use this origin followed by /mcp.
APP_ORIGIN=
# Required to share form tokens across multiple instances. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
WAITLIST_FORM_SECRET=
# Used for both signup form tokens and short-lived signed demo quotes.
HOST=127.0.0.1
PORT=3000
# Public demo identity is in site.json. Override only with accurate public details.
OPERATOR_NAME=Dodona
CONTACT_EMAIL=dodonamarkets@gmail.com
# Optional fixed retention period; leave blank to retain until removal is requested.
WAITLIST_RETENTION_DAYS=
# Only exact proxy addresses/networks controlled by your hosting setup.
# Leave blank for direct connections. Never trust headers from every peer.
TRUSTED_PROXY_CIDRS=
